OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45

EXTRACTOR=gpt
IMAGE_DOMAIN_READER=vision

OCR_PROVIDER=tesseract
TESSERACT_CMD=
TESSERACT_TESSDATA_DIR=
TESSERACT_LANGS=ara+eng
OCR_MIN_DIGIT_CONFIDENCE=0.6

AZURE_DI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DI_KEY=replace-with-your-key
AZURE_DI_API_VERSION=2024-11-30
OCR_FIXTURES_DIR=samples/ocr

REFERENCE_DATA_DIR=team_data

ALLOWED_DOMAINS=localhost,127.0.0.1
ALLOW_LOCALHOST=true
FETCH_TIMEOUT_SECONDS=8
MAX_RESPONSE_BYTES=2000000
MAX_REDIRECTS=5

MAX_IMAGE_BYTES=5000000
MAX_TEXT_CHARS=20000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
